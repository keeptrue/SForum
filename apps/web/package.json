{
  "name": "@sforum/web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "svgo": "4.0.2",
    "devalue": "^5.9.3",
    "sharp": "^0.35.4",
    "prosemirror-model": "^1.25.12",
    "prosemirror-view": "^1.42.6"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --dotenv ../../.env",
    "build": "NUXT_BUILD_DIR=${NUXT_BUILD_DIR:-.nuxt-build} NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=6144} nuxt build",
    "postinstall": "nuxt prepare",
    "preview": "HOST=0.0.0.0 bun --env-file=../../.env scripts/preview.mjs",
    "typecheck": "NUXT_BUILD_DIR=${NUXT_BUILD_DIR:-.nuxt-typecheck} nuxt prepare && vue-tsc --noEmit --incremental --tsBuildInfoFile ${NUXT_BUILD_DIR:-.nuxt-typecheck}.tsbuildinfo -p ${NUXT_BUILD_DIR:-.nuxt-typecheck}/tsconfig.json",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "0.6.1",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/tabler": "^1.2.35",
    "@iconify/vue": "^5.0.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/seo": "^5.3.6",
    "@sforum/admin-sdk": "workspace:*",
    "@sforum/plugin-ui": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-file-handler": "3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "altcha": "^3.1.0",
    "chart.js": "^4",
    "diff": "^9",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "katex": "^0.16",
    "marked": "^17.0.6",
    "mermaid": "^11",
    "nuxt": "^4.4.8",
    "parse5": "^8.0.1",
    "photoswipe": "^5.4.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/devtools-kit": "^0.7.6",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.6"
  }
}
