{$APP_DOMAIN} {
	encode zstd gzip

	# H4：浏览器层安全响应头。
	header {
		# 强制 HTTPS（生产域名），预防降级攻击。
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 阻止 MIME 嗅探（与 API 侧附件 nosniff 呼应）。
		X-Content-Type-Options "nosniff"
		# 禁止被任意站点嵌入框架，防点击劫持。
		X-Frame-Options "DENY"
		# 仅在同源请求中发送 Referer，避免泄漏完整 URL 到第三方。
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Nuxt SSR 给带 hash 的静态资源标签注入 crossorigin 属性，浏览器按 CORS
	# 模式请求；手机 QQ（X5）云端加速经代理中转后按跨源校验，缺 ACAO 头会
	# 直接拒载入口 JS，触发 “Cross-origin script load denied” 错误页。
	# CORP 同步放开：扩展/主题资产在 API 侧是 same-origin，代理层换成它的 CDN
	# 域后，no-cors 资源（样式、图标）也会被这枚头拦掉。
	# defer 必须保留：默认 header 在反代之前写入，上游的 same-origin 会再追加
	# 一份，响应里出现两个 CORP 值（实测 `cross-origin` + `same-origin`）。
	@cors_assets path /_nuxt/* /_sforum/*
	header @cors_assets {
		defer
		Access-Control-Allow-Origin "*"
		Timing-Allow-Origin "*"
		Cross-Origin-Resource-Policy "cross-origin"
	}

	# Nitro 的 HTTP sendProxy 不接管 Upgrade。生产 WebSocket 直接进入 Host
	# API，仍由 Go route ingress、Host guards、Safe Mode 和 Dispatcher 授权。
	# vite-hmr 是 Host 保留的开发子协议，继续交给 Nuxt，避免本配置用于本地
	# 调试时截断 HMR。未知 Upgrade 由 Go 返回 404，不回落到 Nuxt。
	route {
		@host_api_websocket {
			header_regexp connection_upgrade Connection (?i)(^|.*,\s*)upgrade(\s*,.*|$)
			header_regexp websocket_upgrade Upgrade (?i)^websocket$
			not header Sec-WebSocket-Protocol *vite-hmr*
		}

		reverse_proxy @host_api_websocket 127.0.0.1:{$API_PORT:18080} {
			# Caddy 默认保留原始 Host、Origin、Cookie、Authorization 和 Upgrade；
			# 不在这里重写这些 Host authority 输入。
			# 客户端 IP 一律在本层重新计算：{client_ip} 在没配 trusted_proxies 时
			# 等于 {remote_host}，配了之后按 CDN 链算出真实客户端。CDN 的单值头
			# 在这里删掉，否则上游会把任意客户端自带的头当成客户端 IP。
			header_up X-Real-IP {client_ip}
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
		}

		# 普通 HTTP 和 Nuxt HMR 仍走 Web。X-Real-IP 由本层按 {client_ip} 重写，
		# Nuxt 把它规范化成单值后上行（Nitro 运行时拿不到 TCP 对端），API 看到的
		# 对端始终是 web 容器，因此不需要把 Caddy 网段写进应用侧 TRUSTED_PROXIES。
		#
		# 前面有 CDN（Cloudflare 等）时，在本文件顶部加全局选项块，由 Caddy 负责
		# 剥头与计算 {client_ip}，应用侧 TRUSTED_PROXIES 保持为空：
		#   {
		#       servers {
		#           trusted_proxies static <CDN 出口段...>
		#           client_ip_headers CF-Connecting-IP True-Client-IP X-Forwarded-For
		#       }
		#   }
		# client_ip_headers 可省略（默认只认 X-Forwarded-For）；Cloudflare 必须
		# 显式加上 CF-Connecting-IP。trusted_proxies 必须写在 servers 块里，
		# Caddy 2.10 不认顶层同名选项。不要把 CDN 段写进应用侧
		# TRUSTED_PROXIES：应用侧只该看到本层写好的 X-Real-IP，再解析一次只会
		# 把唯一的边缘地址当成代理剥掉。
		reverse_proxy 127.0.0.1:{$WEB_PORT:3000} {
			header_up X-Real-IP {client_ip}
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
		}
	}
}
