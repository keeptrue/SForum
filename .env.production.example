# Startup fallbacks for admin-managed site settings.
# Edit runtime values from Admin > Site Settings after the app is running.
APP_NAME=SForum
APP_ENV=production
# 仅宿主机 Caddy 示例使用；不会传入应用容器。
APP_DOMAIN=forum.example.com
APP_URL=https://forum.example.com
APP_LOCALE=zh-CN
SUPPORTED_LOCALES=zh-CN,en-US
LOG_LEVEL=info

# 发布镜像版本。deploy.sh/upgrade.sh 会在运行时注入解析后的不可变标签；
# 直接使用 compose.release.yaml 手动部署时必须在这里固定具体版本。
# 不要写 latest：生产 Compose 只运行 vX.Y.Z 这样的不可变标签。
# SFORUM_VERSION=v2.8.0
# SFORUM_REGISTRY=ghcr.io/keeptrue

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# API 请求体硬上限。默认 64 MiB，附件业务上限还会再经过站点与身份策略收紧。
HTTP_BODY_LIMIT=67108864
WEB_PORT=3000
# Loopback-only Host API ingress used by Caddy for WebSocket Upgrade requests.
API_PORT=18080

POSTGRES_DB=sforum
POSTGRES_USER=sforum
POSTGRES_PASSWORD=change-me
# Compose 内部 PostgreSQL 网络不启用 TLS；外部数据库应按提供商要求改为
# verify-full 并配置受信任证书。
DATABASE_URL=postgres://sforum:change-me@postgres:5432/sforum?sslmode=disable
# true：API 启动时自动迁移；deploy.sh 与配置向导写入 false，并显式执行 migrate。
# 两种模式二选一：设为 false 时必须先运行 migrate 服务，否则应用会因缺表失败。
MIGRATE_ON_STARTUP=true
DATABASE_MAX_CONNS=10
# 推荐默认：API 内嵌 River worker，复用数据库池和插件 runtime。
WORKER_SHUTDOWN_TIMEOUT=30s

JOB_QUEUE_CRITICAL_WORKERS=4
JOB_QUEUE_DEFAULT_WORKERS=8
JOB_QUEUE_SEARCH_WORKERS=6
JOB_QUEUE_MAIL_WORKERS=4
JOB_QUEUE_NOTIFICATIONS_WORKERS=6
JOB_QUEUE_MAINTENANCE_WORKERS=2

REDIS_ADDR=redis:6379
# Redis 认证密码：compose 默认对 Redis 启用 --requirepass。
# 使用外部无密码 Redis 时置空，并需同步调整 compose.yaml 移除 --requirepass。
REDIS_PASSWORD=change-me

# Startup fallbacks for the admin-managed verification tab.
HUMAN_VERIFICATION_PROVIDER=disabled
ALTCHA_SECRET=change-me
ALTCHA_CHALLENGE_TTL=10m
ALTCHA_COST=1000

EXTENSION_ROOT=/var/lib/sforum/extensions
BUILTIN_EXTENSION_ROOT=/app/extensions/builtin
# 可选，逗号分隔，必须填写容器内路径并通过只读 volume 映射源码集合。
# EXTERNAL_EXTENSION_ROOTS=/opt/sforum-plugins
SFORUM_V3_TRUST_CHALLENGES=true
SFORUM_V3_TRUST_CHALLENGE_TTL=5m

# 可选：仅当安装并启用 search.provider（如 Meilisearch 插件）时配置
# MEILI_HOST=http://meilisearch:7700
# MEILI_MASTER_KEY=change-me

# 会话签名密钥（实际读取的变量名）。生产部署必须替换为高熵随机值。
SESSION_HASH_SECRET=change-me

# 外部主体 digest 的 Host HMAC 密钥（≥32 字节原文，或 ≥64 hex 字符）。
# 生产必须显式配置；开发默认不得用于生产。密钥属于 identity 备份/恢复。
# 生成方式：openssl rand -hex 32
IDENTITY_SUBJECT_HMAC_SECRET=change-me

# option 敏感值（云存储/SSH/FTP 凭证）AES-256-GCM 加密密钥，hex 编码的 32 字节（64 hex 字符）。
# 生产环境必须配置，否则启动会被拒绝（C2）。缺失时历史明文值会被自动加密迁移。
# 生成方式：openssl rand -hex 32
APP_OPTION_ENC_KEY=change-me-64-hex-chars

# CSRF 信任来源站点。API 在反向代理后看到的 Host 是内部地址，而 Origin 是公开站点，
# 二者不匹配会被 CSRF 中间件拒绝，因此必须列出公开站点 origin。
# 留空时自动从 APP_URL 派生；多站点用逗号分隔，支持通配符子域如 https://*.example.com。
CSRF_TRUSTED_ORIGINS=https://forum.example.com

# 反向代理真实客户端 IP。生产默认不信任任何网段：只有部署在宿主机反代之后，
# 才开启 TRUST_PROXY，并把 TRUSTED_PROXIES 设为反代地址/网段（逗号分隔）。
# 不要填 0.0.0.0/0；无脑信任会让伪造 X-Forwarded-For 绕过限流与审计。
# TRUST_PROXY=true
# TRUSTED_PROXIES=127.0.0.1/32
# TRUST_PROXY_PRIVATE=false
# TRUST_PROXY_LOOPBACK=false

# 扩展导致启动失败时的带外恢复：设为 true 并重启 api，可跳过插件启动进入
# Safe Mode；恢复后改回 false 再重启。详细步骤见部署故障排查文档。
# SFORUM_SAFE_MODE=true

NUXT_PUBLIC_API_BASE_URL=/api/v1
NUXT_API_INTERNAL_BASE_URL=http://api:8080/api/v1
NUXT_PUBLIC_ADMIN_ROUTE_PREFIX=/control-panel
