{
  "manifestVersion": 3,
  "id": "sforum.auth-github",
  "name": "GitHub Login",
  "description": "Protected built-in GitHub OAuth protocol adapter. Host owns accounts, callback state, and sessions.",
  "url": "https://github.com/keeptrue/sforum",
  "author": {
    "name": "SForum",
    "url": "https://github.com/keeptrue/sforum"
  },
  "version": "1.0.8",
  "type": "plugin",
  "sforumVersion": ">=0.1.0",
  "capabilities": [
    "host.api",
    "settings.own",
    "net.outbound"
  ],
  "backend": {
    "entry": "backend/plugin",
    "rpc": "hashicorp-go-plugin",
    "protocolVersion": 2,
    "hostApiVersion": "sforum.host@2",
    "digest": "f21bfbc710ab95e6a0ffaa85873446f8004b7164363939b3f6af8b5d3aa45bae"
  },
  "includes": {
    "admin": "manifest/admin.json",
    "langs": "manifest/langs",
    "settings": "manifest/settings.json"
  },
  "identity": {
    "contractVersion": "sforum.auth-github.identity@1",
    "providers": [
      {
        "id": "sforum.auth-github.auth",
        "contractVersion": "sforum.auth-github.auth@1",
        "kind": "auth",
        "handler": "sforum.auth-github.identity",
        "priority": 100,
        "label": {
          "zh-CN": "GitHub",
          "en-US": "GitHub"
        },
        "icon": "i-tabler-brand-github",
        "operations": [
          {
            "name": "registration.start",
            "inputSchema": "schemas/start.input.json",
            "outputSchema": "schemas/start.output.json",
            "timeoutMs": 4000,
            "failurePolicy": "fail_closed"
          },
          {
            "name": "registration.complete",
            "inputSchema": "schemas/complete.input.json",
            "outputSchema": "schemas/auth.complete.output.json",
            "timeoutMs": 4000,
            "failurePolicy": "fail_closed"
          },
          {
            "name": "login.start",
            "inputSchema": "schemas/start.input.json",
            "outputSchema": "schemas/start.output.json",
            "timeoutMs": 4000,
            "failurePolicy": "fail_closed"
          },
          {
            "name": "login.complete",
            "inputSchema": "schemas/complete.input.json",
            "outputSchema": "schemas/auth.complete.output.json",
            "timeoutMs": 4000,
            "failurePolicy": "fail_closed"
          },
          {
            "name": "link.start",
            "inputSchema": "schemas/start.input.json",
            "outputSchema": "schemas/start.output.json",
            "timeoutMs": 4000,
            "failurePolicy": "fail_closed"
          },
          {
            "name": "link.complete",
            "inputSchema": "schemas/complete.input.json",
            "outputSchema": "schemas/auth.complete.output.json",
            "timeoutMs": 4000,
            "failurePolicy": "fail_closed"
          },
          {
            "name": "provider.probe",
            "inputSchema": "schemas/probe.input.json",
            "outputSchema": "schemas/probe.output.json",
            "timeoutMs": 3000,
            "failurePolicy": "fail_closed"
          }
        ]
      }
    ]
  },
  "lifecycle": {
    "contractVersion": "sforum.auth-github.lifecycle@1",
    "install": {"plan": "lifecycle.install.plan", "execute": "lifecycle.install", "progressSchema": "sforum.auth-github.lifecycle.progress@1", "checkpointSchema": "sforum.auth-github.lifecycle.checkpoint@1"},
    "enable": {"plan": "lifecycle.enable.plan", "execute": "lifecycle.enable", "progressSchema": "sforum.auth-github.lifecycle.progress@1", "checkpointSchema": "sforum.auth-github.lifecycle.checkpoint@1"},
    "disable": {"plan": "lifecycle.disable.plan", "execute": "lifecycle.disable", "progressSchema": "sforum.auth-github.lifecycle.progress@1", "checkpointSchema": "sforum.auth-github.lifecycle.checkpoint@1"},
    "upgrade": {"plan": "lifecycle.upgrade.plan", "execute": "lifecycle.upgrade", "progressSchema": "sforum.auth-github.lifecycle.progress@1", "checkpointSchema": "sforum.auth-github.lifecycle.checkpoint@1"},
    "rollback": {"plan": "lifecycle.rollback.plan", "execute": "lifecycle.rollback", "progressSchema": "sforum.auth-github.lifecycle.progress@1", "checkpointSchema": "sforum.auth-github.lifecycle.checkpoint@1"},
