{
  "manifestVersion": 3,
  "id": "sforum.commerce-workflow",
  "name": "SForum Commerce Workflow Reference",
  "description": "Protocol V2 reference plugin proving routes, own-schema database, hooks, jobs, schedules, CLI commands, custom guards, streaming, lifecycle uninstall, cache, OpenAPI, components, and services for a trusted commerce/workflow vertical.",
  "url": "https://github.com/keeptrue/sforum",
  "author": {
    "name": "SForum",
    "url": "https://github.com/keeptrue/sforum"
  },
  "version": "1.0.0",
  "type": "plugin",
  "sforumVersion": ">=0.1.0",
  "capabilities": [
    "host.api"
  ],
  "backend": {
    "entry": "backend/plugin",
    "rpc": "hashicorp-go-plugin",
    "protocolVersion": 2,
    "hostApiVersion": "sforum.host@2",
    "digest": "__BACKEND_DIGEST__"
  },
  "permissionDefinitions": [
    {
      "key": "sforum.commerce-workflow.manage",
      "contractVersion": "sforum.commerce-workflow.manage@1",
      "label": "Manage commerce workflow",
      "description": "Operate the reference commerce workflow vertical.",
      "recommendedRoles": [
        "administrator"
      ],
      "assignmentPolicy": "host"
    }
  ],
  "database": {
    "contractVersion": "sforum.commerce-workflow.database@1",
    "grants": [
      "own_schema"
    ],
    "schema": "sforum_commerce_workflow",
    "role": "sforum_commerce_workflow",
    "backup": {
      "required": true,
      "strategy": "pg_dump"
    },
    "retention": {
      "onDisable": "retain",
      "onUninstall": "export",
      "days": 30
    }
  },
  "guards": [
    {
      "id": "sforum.commerce-workflow.guard.owner",
      "contractVersion": "sforum.commerce-workflow.guard.owner@1",
      "kind": "custom",
      "entry": "backend/plugin",
      "digest": "__BACKEND_DIGEST__",
      "permissions": [
        "sforum.commerce-workflow.manage"
      ]
    },
    {
      "id": "sforum.commerce-workflow.guard.raw",
      "contractVersion": "sforum.commerce-workflow.guard.raw@1",
      "kind": "raw_request",
      "entry": "backend/plugin",
      "digest": "__BACKEND_DIGEST__"
    }
  ],
  "routes": [
    {
      "id": "sforum.commerce-workflow.route.orders",
      "contractVersion": "sforum.commerce-workflow.route.orders@1",
      "action": "add",
      "path": "/api/commerce-workflow/orders",
      "methods": [
        "GET"
      ],
      "guard": "core.guard.public",
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.orders",
      "responseSchema": "sforum.commerce-workflow.route.orders.response@1"
    },
    {
      "id": "sforum.commerce-workflow.route.orders-alias",
      "contractVersion": "sforum.commerce-workflow.route.orders-alias@1",
      "action": "alias",
      "targetId": "core.route.forum.topics",
      "path": "/api/commerce-workflow/v1/topics-alias",
      "methods": [
        "GET"
      ],
      "guard": "core.guard.inherit",
      "fallback": "closed",
      "mode": "http"
    },
    {
      "id": "sforum.commerce-workflow.route.legacy-redirect",
      "contractVersion": "sforum.commerce-workflow.route.legacy-redirect@1",
      "action": "redirect",
      "path": "/commerce-workflow/old-orders",
      "methods": [
        "GET"
      ],
      "guard": "core.guard.public",
      "fallback": "closed",
      "mode": "http",
      "destination": "/commerce-workflow/orders"
    },
    {
      "id": "sforum.commerce-workflow.route.orders-rewrite",
      "contractVersion": "sforum.commerce-workflow.route.orders-rewrite@1",
      "action": "rewrite",
      "targetId": "core.route.forum.topics",
      "path": "/api/commerce-workflow/rewrite/topics",
      "methods": [
        "GET"
      ],
      "guard": "core.guard.inherit",
      "fallback": "closed",
      "mode": "http"
    },
    {
      "id": "sforum.commerce-workflow.route.topics-before",
      "contractVersion": "sforum.commerce-workflow.route.topics-before@1",
      "action": "before",
      "targetId": "core.route.forum.topics",
      "path": "/api/v1/topics",
      "methods": [
        "GET"
      ],
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.topics-before",
      "mutableRequestFields": [
        "/query/commerceTrace"
      ]
    },
    {
      "id": "sforum.commerce-workflow.route.topics-after",
      "contractVersion": "sforum.commerce-workflow.route.topics-after@1",
      "action": "after",
      "targetId": "core.route.forum.topics",
      "path": "/api/v1/topics",
      "methods": [
        "GET"
      ],
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.topics-after",
      "mutableResponseFields": [
        "/headers/x-commerce-trace"
      ]
    },
    {
      "id": "sforum.commerce-workflow.route.topics-filter",
      "contractVersion": "sforum.commerce-workflow.route.topics-filter@1",
      "action": "filter",
      "targetId": "core.route.forum.topics",
      "path": "/api/v1/topics",
      "methods": [
        "GET"
      ],
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.topics-filter",
      "responseSchema": "sforum.route.forum.topics.response@1",
      "mutableResponseFields": [
        "/body/commerceFiltered"
      ]
    },
    {
      "id": "sforum.commerce-workflow.route.create-topic-wrap",
      "contractVersion": "sforum.commerce-workflow.route.create-topic-wrap@1",
      "action": "wrap",
      "targetId": "core.route.forum.create_topic",
      "path": "/api/v1/topics",
      "methods": [
        "POST"
      ],
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.create-topic-wrap",
      "requestSchema": "sforum.route.forum.create_topic.request@1",
      "responseSchema": "sforum.route.forum.create_topic.response@1",
      "mutableRequestFields": [
        "/body/commerceWrapped"
      ],
      "mutableResponseFields": [
        "/body/commerceWrapResult"
      ]
    },
    {
      "id": "sforum.commerce-workflow.route.create-topic-replace",
      "contractVersion": "sforum.commerce-workflow.route.create-topic-replace@1",
      "action": "replace",
      "targetId": "core.route.forum.create_topic",
      "path": "/api/v1/topics",
      "methods": [
        "POST"
      ],
      "guard": "sforum.commerce-workflow.guard.raw",
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.create-topic-replace",
      "requestSchema": "sforum.route.forum.create_topic.request@1",
      "responseSchema": "sforum.route.forum.create_topic.response@1"
    },
    {
      "id": "sforum.commerce-workflow.route.managed-orders",
      "contractVersion": "sforum.commerce-workflow.route.managed-orders@1",
      "action": "add",
      "path": "/api/commerce-workflow/managed-orders",
      "methods": [
        "GET"
      ],
      "guard": "sforum.commerce-workflow.guard.owner",
      "fallback": "closed",
      "mode": "http",
      "handler": "sforum.commerce-workflow.route.managed-orders",
      "responseSchema": "sforum.commerce-workflow.route.managed-orders.response@1"
    },
    {
      "id": "sforum.commerce-workflow.route.events",
      "contractVersion": "sforum.commerce-workflow.route.events@1",
      "action": "add",
      "path": "/api/commerce-workflow/events",
      "methods": [
        "GET"
      ],
      "guard": "core.guard.login",
      "fallback": "closed",
      "mode": "sse",
      "handler": "sforum.commerce-workflow.route.events",
      "responseSchema": "sforum.commerce-workflow.route.events.response@1"
    },
    {
      "id": "sforum.commerce-workflow.route.stream",
      "contractVersion": "sforum.commerce-workflow.route.stream@1",
      "action": "add",
      "path": "/api/commerce-workflow/stream",
      "methods": [
        "GET"
      ],
      "guard": "core.guard.login",
      "fallback": "closed",
      "mode": "stream",
      "handler": "sforum.commerce-workflow.route.stream",
      "responseSchema": "sforum.commerce-workflow.route.stream.response@1"
    }
  ],
  "hooks": [
    {
      "id": "sforum.commerce-workflow.hook.order-evaluate",
      "contractVersion": "sforum.commerce-workflow.hook.order-evaluate@1",
      "name": "sforum.commerce-workflow.order.evaluate",
      "kind": "filter",
      "handler": "sforum.commerce-workflow.hook.order-evaluate",
      "inputSchema": "sforum.commerce-workflow.hook.order-evaluate.input@1",
      "resultSchema": "sforum.commerce-workflow.hook.order-evaluate.result@1",
      "execution": "sync",
      "failurePolicy": "fail_closed",
      "timeoutMs": 1000,
      "mutableFields": [
        "status"
      ]
    },
    {
      "id": "sforum.commerce-workflow.hook.order-created",
      "contractVersion": "sforum.commerce-workflow.hook.order-created@1",
      "name": "sforum.commerce-workflow.order.created",
      "kind": "observe",
      "handler": "sforum.commerce-workflow.hook.order-created",
      "inputSchema": "sforum.commerce-workflow.hook.order-created.input@1",
      "execution": "async",
      "failurePolicy": "fail_open",
      "timeoutMs": 2000
    }
  ],
  "jobs": [
    {
      "id": "sforum.commerce-workflow.job.settle",
      "contractVersion": "sforum.commerce-workflow.job.settle@1",
      "name": "sforum.commerce-workflow.settle",
      "handler": "sforum.commerce-workflow.job.settle",
      "payloadSchema": "sforum.commerce-workflow.job.settle.payload@1",
      "retryPolicy": "exponential",
      "maxAttempts": 5,
      "concurrencyLimit": 1
    }
  ],
  "schedules": [
    {
      "id": "sforum.commerce-workflow.schedule.settle",
      "contractVersion": "sforum.commerce-workflow.schedule.settle@1",
      "jobId": "sforum.commerce-workflow.job.settle",
      "cron": "0 */6 * * *",
      "timezone": "UTC"
    }
  ],
  "commands": [
    {
      "id": "sforum.commerce-workflow.command.settle-once",
      "contractVersion": "sforum.commerce-workflow.command.settle-once@1",
      "handler": "sforum.commerce-workflow.command.settle-once",
      "permission": "sforum.commerce-workflow.manage",
      "inputSchema": "sforum.commerce-workflow.command.settle-once.input@1",
      "resultSchema": "sforum.commerce-workflow.command.settle-once.result@1",
      "description": "Run one commerce settlement cycle from the Host CLI/admin console.",
      "recoverySafe": true,
      "timeoutMs": 3000
    }
  ],
  "lifecycle": {
    "contractVersion": "sforum.commerce-workflow.lifecycle@1",
    "install": {
      "plan": "sforum.commerce-workflow.lifecycle.install.plan",
      "execute": "sforum.commerce-workflow.lifecycle.install.execute",
      "progressSchema": "sforum.commerce-workflow.lifecycle.progress@1",
      "checkpointSchema": "sforum.commerce-workflow.lifecycle.checkpoint@1"
    },
    "enable": {
      "plan": "sforum.commerce-workflow.lifecycle.enable.plan",
      "execute": "sforum.commerce-workflow.lifecycle.enable.execute",
      "progressSchema": "sforum.commerce-workflow.lifecycle.progress@1",
      "checkpointSchema": "sforum.commerce-workflow.lifecycle.checkpoint@1"
    },
    "disable": {
      "plan": "sforum.commerce-workflow.lifecycle.disable.plan",
      "execute": "sforum.commerce-workflow.lifecycle.disable.execute",
      "progressSchema": "sforum.commerce-workflow.lifecycle.progress@1",
      "checkpointSchema": "sforum.commerce-workflow.lifecycle.checkpoint@1"
    },
    "upgrade": {
      "plan": "sforum.commerce-workflow.lifecycle.upgrade.plan",
      "execute": "sforum.commerce-workflow.lifecycle.upgrade.execute",
      "progressSchema": "sforum.commerce-workflow.lifecycle.progress@1",
      "checkpointSchema": "sforum.commerce-workflow.lifecycle.checkpoint@1"
    },
    "rollback": {
      "plan": "sforum.commerce-workflow.lifecycle.rollback.plan",
      "execute": "sforum.commerce-workflow.lifecycle.rollback.execute",
      "progressSchema": "sforum.commerce-workflow.lifecycle.progress@1",
      "checkpointSchema": "sforum.commerce-workflow.lifecycle.checkpoint@1"
    },
    "uninstall": {
      "plan": "sforum.commerce-workflow.lifecycle.uninstall.plan",
      "execute": "sforum.commerce-workflow.lifecycle.uninstall.execute",
      "progressSchema": "sforum.commerce-workflow.lifecycle.progress@1",
      "checkpointSchema": "sforum.commerce-workflow.lifecycle.checkpoint@1"
    }
  },
  "cache": [
    {
      "id": "sforum.commerce-workflow.cache.orders",
      "contractVersion": "sforum.commerce-workflow.cache.orders@1",
      "namespace": "sforum.commerce-workflow.orders",
      "policy": "permission",
      "tags": [
        "sforum.commerce-workflow.orders"
      ],
      "invalidators": [
        "sforum.commerce-workflow.order.changed"
      ]
    }
  ],
  "services": [
    {
      "id": "sforum.commerce-workflow.service.orders",
      "contractVersion": "sforum.commerce-workflow.service.orders@1",
      "action": "add",
      "handler": "sforum.commerce-workflow.service.orders",
      "requestSchema": "sforum.commerce-workflow.service.orders.request@1",
      "responseSchema": "sforum.commerce-workflow.service.orders.response@1"
    }
  ],
  "components": [
    {
      "id": "sforum.commerce-workflow.component.order-card",
      "contractVersion": "sforum.commerce-workflow.component.order-card@1",
      "action": "add",
      "l2Component": "sforum.commerce-workflow.file.frontend.card",
      "propsSchema": "sforum.commerce-workflow.component.order-card.props@1",
      "resultSchema": "sforum.commerce-workflow.component.order-card.result@1",
      "themeOverrideKey": "sforum.commerce-workflow.order-card"
    }
  ],
  "openapi": [
    {
      "id": "sforum.commerce-workflow.openapi.routes",
      "contractVersion": "sforum.commerce-workflow.openapi.routes@1",
      "path": "openapi/routes.yaml",
      "digest": "__OPENAPI_DIGEST__",
      "namespace": "sforum.commerce-workflow"
    }
  ],
  "packageFiles": [
    {
      "id": "sforum.commerce-workflow.file.backend",
      "kind": "executable",
      "path": "backend/plugin",
      "digest": "__BACKEND_DIGEST__"
    },
    {
      "id": "sforum.commerce-workflow.file.frontend.card",
      "kind": "frontend",
      "path": "frontend/order-card.mjs",
      "digest": "__FRONTEND_DIGEST__",
      "version": "1"
    },
    {
      "id": "sforum.commerce-workflow.file.openapi",
      "kind": "openapi",
      "path": "openapi/routes.yaml",
      "digest": "__OPENAPI_DIGEST__"
    },
    {
      "id": "sforum.commerce-workflow.command.settle-once.input",
      "kind": "schema",
      "path": "schemas/command-settle-input.json",
      "digest": "__COMMAND_INPUT_DIGEST__",
      "version": "1"
    },
    {
      "id": "sforum.commerce-workflow.command.settle-once.result",
      "kind": "schema",
      "path": "schemas/command-settle-result.json",
      "digest": "__COMMAND_RESULT_DIGEST__",
      "version": "1"
    },
    {
      "id": "sforum.commerce-workflow.component.order-card.props",
      "kind": "schema",
      "path": "schemas/order-card-props.json",
      "digest": "__ORDER_CARD_PROPS_DIGEST__",
      "version": "1"
    },
    {
      "id": "sforum.commerce-workflow.component.order-card.result",
      "kind": "schema",
      "path": "schemas/order-card-result.json",
      "digest": "__ORDER_CARD_RESULT_DIGEST__",
      "version": "1"
    }
  ]
}
