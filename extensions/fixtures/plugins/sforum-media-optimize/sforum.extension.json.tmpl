{
  "manifestVersion": 3,
  "id": "sforum.media-optimize",
  "name": "SForum Media Optimize Reference",
  "description": "Protocol V2 reference plugin proving Media Pipeline MIME policy, transforms/variants, background jobs, scheduled retention cleanup, and original fallback on failure/disable.",
  "url": "https://github.com/keeptrue/sforum",
  "author": {
    "name": "SForum",
    "url": "https://github.com/keeptrue/sforum"
  },
  "version": "1.0.0",
  "type": "plugin",
  "sforumVersion": ">=0.1.0",
  "capabilities": ["host.api"],
  "backend": {
    "entry": "backend/plugin",
    "rpc": "hashicorp-go-plugin",
    "protocolVersion": 2,
    "hostApiVersion": "sforum.host@2",
    "digest": "__BACKEND_DIGEST__"
  },
  "permissionDefinitions": [
    {
      "key": "sforum.media-optimize.transform",
      "contractVersion": "sforum.media-optimize.transform@1",
      "label": "Optimize media",
      "description": "Run reference media transforms and background optimize jobs.",
      "recommendedRoles": ["administrator"],
      "assignmentPolicy": "host"
    },
    {
      "key": "sforum.media-optimize.bulk",
      "contractVersion": "sforum.media-optimize.bulk@1",
      "label": "Bulk media optimize",
      "description": "Run admin bulk optimize and retention cleanup tools.",
      "recommendedRoles": ["administrator"],
      "assignmentPolicy": "host"
    }
  ],
  "media": [
    {
      "id": "sforum.media-optimize.pipeline.image",
      "contractVersion": "sforum.media-optimize.pipeline.image@1",
      "action": "add",
      "mimes": ["image/png", "image/jpeg", "image/webp"],
      "handler": "sforum.media-optimize.transform",
      "permission": "sforum.media-optimize.transform",
      "transforms": [
        {
          "id": "thumbnail",
          "variant": "thumb",
          "format": "webp",
          "width": 320,
          "height": 240
        },
        {
          "id": "preview",
          "variant": "preview",
          "format": "webp",
          "width": 960,
          "height": 540
        }
      ]
    }
  ],
  "jobs": [
    {
      "id": "sforum.media-optimize.job.variants",
      "contractVersion": "sforum.media-optimize.job.variants@1",
      "name": "sforum.media-optimize.variants",
      "handler": "sforum.media-optimize.job.variants",
      "payloadSchema": "sforum.media-optimize.job.variants.payload@1",
      "retryPolicy": "bounded",
      "maxAttempts": 3,
      "retryDelaySeconds": 5,
      "concurrencyLimit": 2
    },
    {
      "id": "sforum.media-optimize.job.retention",
      "contractVersion": "sforum.media-optimize.job.retention@1",
      "name": "sforum.media-optimize.retention",
      "handler": "sforum.media-optimize.job.retention",
      "payloadSchema": "sforum.media-optimize.job.retention.payload@1",
      "retryPolicy": "bounded",
      "maxAttempts": 2,
      "retryDelaySeconds": 30,
      "concurrencyLimit": 1
    }
  ],
  "schedules": [
    {
      "id": "sforum.media-optimize.schedule.retention",
      "contractVersion": "sforum.media-optimize.schedule.retention@1",
      "jobId": "sforum.media-optimize.job.retention",
      "cron": "15 3 * * *",
      "timezone": "UTC"
    }
  ],
  "adminSurfaces": [
    {
      "id": "sforum.media-optimize.admin.bulk-notice",
      "contractVersion": "sforum.media-optimize.admin.bulk-notice@1",
      "kind": "notice",
      "action": "add",
      "placementId": "core.component.page.admin.attachments",
      "placementContractVersion": "sforum.component.page.admin.attachments@1",
      "label": "Media optimize bulk tools",
      "handler": "sforum.media-optimize.admin.bulk-notice",
      "propsSchema": "sforum.media-optimize.admin.bulk-notice.props@1",
      "resultSchema": "sforum.media-optimize.admin.bulk-notice.result@1",
      "operation": "query",
      "permission": "sforum.media-optimize.bulk",
      "priority": 20
    }
  ],
  "packageFiles": [
    {
      "id": "sforum.media-optimize.file.backend",
      "kind": "executable",
      "path": "backend/plugin",
      "digest": "__BACKEND_DIGEST__"
    },
    {
      "id": "sforum.media-optimize.admin.bulk-notice.props",
      "kind": "schema",
      "path": "schemas/bulk-notice-props.json",
      "digest": "__BULK_PROPS_DIGEST__",
      "version": "1"
    },
    {
      "id": "sforum.media-optimize.admin.bulk-notice.result",
      "kind": "schema",
      "path": "schemas/bulk-notice-result.json",
      "digest": "__BULK_RESULT_DIGEST__",
      "version": "1"
    }
  ]
}
